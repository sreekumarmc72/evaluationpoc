# Backend only. Copy to .env in the project root.
OPENAI_API_KEY=
# Required: use the exact model ID you have access to; no fallback.
OPENAI_MODEL=
PORT=3001
MODEL_TIMEOUT_MS=180000
MAX_FILE_MB=10
MAX_PDF_PAGES=10
RETENTION_MS=3600000

# Hosting only: Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN.
# NODE_ENV=production
# HOST=0.0.0.0
# Mount a Railway volume here; never use ephemeral storage for prepared exams.
# DATA_DIR=/data
# Optional explicit public origin; otherwise Railway's public domain is used.
# APP_ORIGIN=https://your-service.up.railway.app
# Render supplies RENDER_EXTERNAL_URL automatically; APP_ORIGIN is optional there too.

